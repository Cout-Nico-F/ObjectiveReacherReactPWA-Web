<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ObjectiveReacherMAUI.Controls"
             x:Name="MainPageRoot"
             x:Class="ObjectiveReacherMAUI.MainPage"
             Title="ObjectiveReacher"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource DashboardBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
    </ContentPage.Resources>

    <Grid x:Name="DashboardGrid"
          ColumnDefinitions="0,*,0"
          BackgroundColor="{StaticResource DashboardBackground}">
        <Border x:Name="CelebrationOverlay" Grid.ColumnSpan="3" IsVisible="False" Opacity="0" Scale="0.82" ZIndex="10" HorizontalOptions="Center" VerticalOptions="Center" Padding="26,20" Stroke="#806F62" StrokeThickness="2" StrokeShape="RoundRectangle 24" BackgroundColor="#F01C1C2B" InputTransparent="False">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" WidthRequest="260">
                <Label x:Name="CelebrationEmoji" FontSize="54" HorizontalTextAlignment="Center" />
                <Label x:Name="CelebrationTitle" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label x:Name="CelebrationMessage" FontSize="13" TextColor="#E6E0F2" HorizontalTextAlignment="Center" />
                <Button x:Name="CelebrationCloseButton" Text="Cerrar" Clicked="OnCelebrationCloseClicked" IsVisible="False" BackgroundColor="#604094" TextColor="White" CornerRadius="10" />
            </VerticalStackLayout>
        </Border>

        <ScrollView x:Name="DashboardContent" Grid.Column="0" Grid.ColumnSpan="3">
            <VerticalStackLayout Padding="16,12,16,20" Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Button x:Name="NavigationButton" Text="☰" Clicked="OnNavigationClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="21" BackgroundColor="#242238" TextColor="#D9C9FF" CornerRadius="12" SemanticProperties.Description="Abrir navegación" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label Text="🎯" FontSize="23" VerticalOptions="Center" />
                        <Label Text="Objetivo Actual" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="2" Text="✎" Clicked="OnEditObjectiveClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="19" BackgroundColor="#242238" TextColor="#D9C9FF" CornerRadius="12" SemanticProperties.Description="Editar objetivo" />
                    <Button x:Name="HistoryButton" Grid.Column="3" Text="☷" Clicked="OnHistoryClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20" BackgroundColor="#242238" TextColor="#D9C9FF" CornerRadius="12" SemanticProperties.Description="Abrir historial de entradas" />
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout x:Name="ObjectiveTabsLayout" BindableLayout.ItemsSource="{Binding ObjectiveTabs}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Title}" CommandParameter="{Binding Id}" Clicked="OnObjectiveTabClicked" BackgroundColor="{Binding BackgroundColor}" TextColor="{Binding TextColor}" CornerRadius="12" Padding="16,8" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ObjectiveCount, StringFormat='{}{0} objetivos'}" FontSize="12" TextColor="{StaticResource DashboardMutedText}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Archivados" Clicked="OnArchivedObjectivesClicked" Padding="10,6" FontSize="12" BackgroundColor="#302747" TextColor="White" CornerRadius="10" />
                    <Button Grid.Column="2" Text="＋ Nuevo objetivo" Clicked="OnAddObjectiveClicked" Padding="12,6" FontSize="12" BackgroundColor="{StaticResource DashboardAccent}" TextColor="White" CornerRadius="10" />
                </Grid>

                <Border x:Name="ObjectiveSection" Padding="0" HeightRequest="370" Stroke="#3C3158" StrokeThickness="1" StrokeShape="RoundRectangle 22" Background="{Binding HeroBackground}">
                    <Grid HeightRequest="370" MinimumHeightRequest="370" MaximumHeightRequest="370" IsClippedToBounds="True">
                        <controls:CroppedBannerImage Source="{Binding BannerImageSource}" OffsetX="{Binding BannerTranslationX}" OffsetY="{Binding BannerTranslationY}" Opacity="0.72" InputTransparent="True" />
                        <BoxView BackgroundColor="#99211D35" InputTransparent="True" />
                        <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding ObjectiveTitle}" FontSize="21" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding ObjectiveDescription}" FontSize="13" TextColor="#D0C5E7" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="▧  Fondo" Clicked="OnChangeBannerClicked" VerticalOptions="Start" Padding="12,8" FontSize="12" BackgroundColor="#B3211D35" TextColor="White" CornerRadius="12" SemanticProperties.Description="Elegir banner de fondo" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,76,*" ColumnSpacing="6" VerticalOptions="Center" Padding="0,4">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="AHORRADO" FontSize="11" FontAttributes="Bold" TextColor="#9AF0AE" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding CurrentAmountText}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                                <Grid Grid.Column="1" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" VerticalOptions="Center">
                                    <controls:CircularProgressView Progress="{Binding Progress}" />
                                    <Label Text="{Binding ProgressText}" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="META" FontSize="11" FontAttributes="Bold" TextColor="#DEC2FF" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding GoalAmountText}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Grid.Row="2" Spacing="8">
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="#58D477" BackgroundColor="#51436C" HeightRequest="12" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding RemainingText}" FontSize="12" TextColor="#F0EAF8" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding ObjectiveCount, StringFormat='{}{0} objetivos'}" FontSize="11" TextColor="#D8D1E5" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="EntriesSection" Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Agregar entrada" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                            <Label Text="Suma o resta para avanzar hacia tu objetivo" FontSize="11" TextColor="{StaticResource DashboardMutedText}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="＋ SUMAR" Command="{Binding AddModeCommand}" HeightRequest="54" FontAttributes="Bold" BackgroundColor="{Binding AddModeBackground}" TextColor="#BFF5CE" CornerRadius="12" />
                            <Button Grid.Column="1" Text="− RESTAR" Command="{Binding SubtractModeCommand}" HeightRequest="54" FontAttributes="Bold" BackgroundColor="{Binding SubtractModeBackground}" TextColor="#FFD1D7" CornerRadius="12" />
                        </Grid>
                        <Label Text="ACCESOS RÁPIDOS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource DashboardMutedText}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <Button Text="{Binding QuickAmount50Text}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="50" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="{Binding QuickAmount50Background}" TextColor="#E2D8FF" CornerRadius="10" />
                            <Button Grid.Column="1" Text="{Binding QuickAmount100Text}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="100" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="{Binding QuickAmount100Background}" TextColor="#E2D8FF" CornerRadius="10" />
                            <Button Grid.Column="2" Text="{Binding QuickAmount500Text}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="500" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="{Binding QuickAmount500Background}" TextColor="#E2D8FF" CornerRadius="10" />
                            <Button Grid.Column="3" Text="{Binding QuickAmount1000Text}" Command="{Binding SelectQuickAmountCommand}" CommandParameter="1000" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="{Binding QuickAmount1000Background}" TextColor="#E2D8FF" CornerRadius="10" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Text="Otro importe" FontSize="11" TextColor="{StaticResource DashboardMutedText}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding CustomAmountText}" Keyboard="Numeric" Placeholder="Escribe un importe" PlaceholderColor="#88849A" TextColor="{StaticResource DashboardText}" BackgroundColor="#151520" HeightRequest="44" />
                        </Grid>
                        <Label Text="{Binding SelectedAmountText}" FontSize="11" TextColor="#BDB6CE" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding NewEntryDescription}" Grid.Column="0" Placeholder="¿Qué fue esta entrada? (opcional)" PlaceholderColor="#88849A" TextColor="{StaticResource DashboardText}" BackgroundColor="#151520" HeightRequest="48" />
                            <Button Grid.Column="1" Text="AGREGAR" Command="{Binding AddEntryCommand}" HeightRequest="48" Padding="16,0" FontAttributes="Bold" BackgroundColor="{StaticResource DashboardAccent}" TextColor="White" CornerRadius="11" />
                        </Grid>
                        <Label Text="{Binding PersistenceMessage}" FontSize="11" TextColor="#F2A5A5" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="AchievementsSection" Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🏆 Logros" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="VER TODOS" Clicked="OnAllAchievementsClicked" FontSize="10" FontAttributes="Bold" TextColor="#C7A4FF" BackgroundColor="Transparent" VerticalOptions="Center" />
                        </Grid>
                        <CollectionView ItemsSource="{Binding Achievements}"
                                        ItemsLayout="HorizontalList"
                                        HeightRequest="122"
                                        HorizontalScrollBarVisibility="Always"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="210" Margin="0,0,8,4">
                                        <Border Padding="10" Stroke="{Binding TitleColor}" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding CardBackground}" InputTransparent="True">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="{Binding TitleColor}" />
                                                    <Label Text="{Binding Description}" FontSize="10" TextColor="#C3C0CC" LineBreakMode="TailTruncation" MaxLines="2" />
                                                    <Label Text="{Binding StatusText}" FontSize="9" TextColor="#D8D1E5" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Button Text="" BackgroundColor="Transparent" Clicked="OnAchievementClicked" CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibilityText}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding MascotEmoji}" FontSize="38" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding ExperienceText}" FontSize="15" FontAttributes="Bold" TextColor="#D8C5FF" />
                            <ProgressBar Progress="{Binding LevelProgress}" ProgressColor="#B58BFF" BackgroundColor="#38324E" HeightRequest="7" />
                            <Label Text="{Binding LevelProgressText}" FontSize="10" TextColor="{StaticResource DashboardMutedText}" />
                            <Label Text="{Binding MascotMessage}" FontSize="12" TextColor="{StaticResource DashboardMutedText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="🔥 Racha" FontSize="11" FontAttributes="Bold" TextColor="#FFC45D" />
                            <Label Text="{Binding StreakText}" FontSize="11" TextColor="{StaticResource DashboardText}" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border x:Name="StatisticsSection" Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="▥ Estadísticas" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                        <Label Text="{Binding TotalEntryCount, StringFormat='Entradas totales: {0}'}" TextColor="{StaticResource DashboardText}" />
                        <Label Text="{Binding StreakText, StringFormat='Racha global: {0}'}" TextColor="#FFC45D" />
                        <Label Text="{Binding ExperienceText}" TextColor="#C7A4FF" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="SettingsSection" Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="⚙ Ajustes del objetivo" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                        <Button Text="Cambiar banner" Clicked="OnChangeBannerClicked" HorizontalOptions="Start" BackgroundColor="#302747" TextColor="{StaticResource DashboardText}" />
                        <Button Text="Editar nombre, monto y unidad" Clicked="OnEditObjectiveClicked" HorizontalOptions="Start" BackgroundColor="#302747" TextColor="{StaticResource DashboardText}" />
                        <Button Text="Archivar objetivo" Clicked="OnArchiveCurrentObjectiveClicked" HorizontalOptions="Start" BackgroundColor="#302747" TextColor="{StaticResource DashboardText}" />
                        <Button Text="Eliminar objetivo" Clicked="OnDeleteCurrentObjectiveClicked" HorizontalOptions="Start" BackgroundColor="#542A38" TextColor="White" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="DrawerScrim" Grid.ColumnSpan="3" IsVisible="False" BackgroundColor="#99070810" ZIndex="1">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="NavigationPanel" Grid.ColumnSpan="3" IsVisible="False" ZIndex="2" WidthRequest="280" HorizontalOptions="Start" Padding="16,18" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="#171723">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🎯 ObjectiveReacher" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                    <Label Text="Tu progreso, a tu ritmo" FontSize="12" TextColor="#AAA5BB" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Spacing="7">
                    <Button x:Name="ObjectiveNavigationItem" Text="🎯   Objetivo actual" CommandParameter="objective" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="#302747" TextColor="#E6D9FF" CornerRadius="12" />
                    <Button x:Name="EntriesNavigationItem" Text="＋   Entradas" CommandParameter="entries" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button x:Name="HistoryNavigationItem" Text="▤   Historial" CommandParameter="history" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button x:Name="StatisticsNavigationItem" Text="▥   Estadísticas" CommandParameter="stats" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button x:Name="AchievementsNavigationItem" Text="🏆   Logros" CommandParameter="achievements" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button x:Name="SettingsNavigationItem" Text="⚙   Ajustes" CommandParameter="settings" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                </VerticalStackLayout>
                <Border Grid.Row="2" Padding="12" Stroke="#343046" StrokeShape="RoundRectangle 14" BackgroundColor="#211F30">
                    <VerticalStackLayout Spacing="4"><Label Text="🔥 Racha actual" FontSize="13" FontAttributes="Bold" TextColor="#FFC45D" /><Label Text="{Binding StreakText}" FontSize="12" TextColor="#E4DFED" /></VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="HistoryPanel" Grid.ColumnSpan="3" IsVisible="False" ZIndex="2" WidthRequest="320" HorizontalOptions="End" Padding="16,18" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="#171723">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2"><Label Text="Registro de entradas" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" /><Label Text="{Binding HistoryBalanceText}" FontSize="12" TextColor="{StaticResource DashboardMutedText}" /></VerticalStackLayout>
                    <Button x:Name="HistoryCloseButton" Grid.Column="1" Text="×" Clicked="OnClosePanelsClicked" WidthRequest="42" HeightRequest="42" Padding="0" FontSize="22" BackgroundColor="{StaticResource DashboardRaisedPanel}" TextColor="{StaticResource DashboardText}" CornerRadius="12" SemanticProperties.Description="Cerrar historial" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Text="Todas" Command="{Binding SetHistoryFilterCommand}" CommandParameter="all" HeightRequest="40" Padding="2" FontSize="11" BackgroundColor="{Binding AllFilterBackground}" TextColor="White" CornerRadius="10" />
                    <Button Grid.Column="1" Text="Sumas" Command="{Binding SetHistoryFilterCommand}" CommandParameter="add" HeightRequest="40" Padding="2" FontSize="11" BackgroundColor="{Binding AddFilterBackground}" TextColor="#C8C2D6" CornerRadius="10" />
                    <Button Grid.Column="2" Text="Restas" Command="{Binding SetHistoryFilterCommand}" CommandParameter="subtract" HeightRequest="40" Padding="2" FontSize="11" BackgroundColor="{Binding SubtractFilterBackground}" TextColor="#C8C2D6" CornerRadius="10" />
                </Grid>
                <CollectionView ItemsSource="{Binding HistoryEntries}" Grid.Row="2" SelectionMode="None">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Stroke="#2E2C40" StrokeShape="RoundRectangle 12" BackgroundColor="#201F2E">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                    <Label Text="{Binding Symbol}" FontSize="17" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="{Binding Description}" FontSize="13" FontAttributes="Bold" TextColor="#F3F0FA" /><Label Text="{Binding TimeText}" FontSize="10" TextColor="#A8A3B8" /></VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding AmountText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                                    <Button Grid.Column="3" Text="⋯" Clicked="OnEntryActionsClicked" CommandParameter="{Binding Id}" WidthRequest="34" HeightRequest="38" Padding="0" BackgroundColor="Transparent" TextColor="White" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>