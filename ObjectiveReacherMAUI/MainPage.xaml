<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObjectiveReacherMAUI.MainPage"
             Title="ObjectiveReacher"
             SafeAreaEdges="Container"
             BackgroundColor="{StaticResource DashboardBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="DashboardHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#33294E" Offset="0.0" />
            <GradientStop Color="#211D35" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid x:Name="DashboardGrid"
          ColumnDefinitions="0,*,0"
          BackgroundColor="{StaticResource DashboardBackground}">
        <ScrollView x:Name="DashboardContent" Grid.Column="0" Grid.ColumnSpan="3">
            <VerticalStackLayout Padding="16,12,16,20" Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Button x:Name="NavigationButton" Text="☰" Clicked="OnNavigationClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="21" BackgroundColor="#242238" TextColor="#D9C9FF" CornerRadius="12" SemanticProperties.Description="Abrir navegación" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Label Text="🎯" FontSize="23" VerticalOptions="Center" />
                        <Label Text="Objetivo Actual" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Button Grid.Column="2" Text="✎" Clicked="OnEditObjectiveClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="19" BackgroundColor="#242238" TextColor="#D9C9FF" CornerRadius="12" SemanticProperties.Description="Editar objetivo" />
                    <Button x:Name="HistoryButton" Grid.Column="3" Text="☷" Clicked="OnHistoryClicked" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="20" BackgroundColor="#242238" TextColor="#D9C9FF" CornerRadius="12" SemanticProperties.Description="Abrir historial de entradas" />
                </Grid>

                <Border Padding="18" Stroke="#3C3158" StrokeThickness="1" StrokeShape="RoundRectangle 22" Background="{StaticResource DashboardHeroBrush}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding ObjectiveTitle}" FontSize="21" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ObjectiveDescription}" FontSize="13" TextColor="#D0C5E7" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,76,*" ColumnSpacing="6" VerticalOptions="Center" Padding="0,4">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="ACTUAL" FontSize="12" FontAttributes="Bold" TextColor="#65DB85" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding CurrentAmountText}" FontSize="25" FontAttributes="Bold" TextColor="#65DB85" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" WidthRequest="70" HeightRequest="70" Stroke="#E5B945" StrokeThickness="4" StrokeShape="RoundRectangle 40" BackgroundColor="#27223B" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{Binding ProgressText}" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="OBJETIVO" FontSize="12" FontAttributes="Bold" TextColor="#C08AF2" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding GoalAmountText}" FontSize="25" FontAttributes="Bold" TextColor="#DCC7FF" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <ProgressBar Progress="{Binding Progress}" ProgressColor="#58D477" BackgroundColor="#51436C" HeightRequest="12" />
                        <Label Text="{Binding RemainingText}" FontSize="12" TextColor="#D8D1E5" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Agregar entrada" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                            <Label Text="Suma o resta para avanzar hacia tu objetivo" FontSize="11" TextColor="{StaticResource DashboardMutedText}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="＋ SUMAR" Command="{Binding AddModeCommand}" HeightRequest="54" FontAttributes="Bold" BackgroundColor="{Binding AddModeBackground}" TextColor="#BFF5CE" CornerRadius="12" />
                            <Button Grid.Column="1" Text="− RESTAR" Command="{Binding SubtractModeCommand}" HeightRequest="54" FontAttributes="Bold" BackgroundColor="{Binding SubtractModeBackground}" TextColor="#FFD1D7" CornerRadius="12" />
                        </Grid>
                        <Label Text="ACCESOS RÁPIDOS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource DashboardMutedText}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                            <Button Text="$50" Command="{Binding SelectQuickAmountCommand}" CommandParameter="50" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="#29283D" TextColor="#E2D8FF" CornerRadius="10" />
                            <Button Grid.Column="1" Text="$100" Command="{Binding SelectQuickAmountCommand}" CommandParameter="100" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="#29283D" TextColor="#E2D8FF" CornerRadius="10" />
                            <Button Grid.Column="2" Text="$500" Command="{Binding SelectQuickAmountCommand}" CommandParameter="500" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="#29283D" TextColor="#E2D8FF" CornerRadius="10" />
                            <Button Grid.Column="3" Text="$1,000" Command="{Binding SelectQuickAmountCommand}" CommandParameter="1000" HeightRequest="42" Padding="2" FontSize="12" BackgroundColor="#29283D" TextColor="#E2D8FF" CornerRadius="10" />
                        </Grid>
                        <Label Text="{Binding SelectedAmountText}" FontSize="11" TextColor="#BDB6CE" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding NewEntryDescription}" Grid.Column="0" Placeholder="¿Qué fue esta entrada? (opcional)" PlaceholderColor="#88849A" TextColor="{StaticResource DashboardText}" BackgroundColor="#151520" HeightRequest="48" />
                            <Button Grid.Column="1" Text="AGREGAR" Command="{Binding AddEntryCommand}" HeightRequest="48" Padding="16,0" FontAttributes="Bold" BackgroundColor="{StaticResource DashboardAccent}" TextColor="White" CornerRadius="11" />
                        </Grid>
                        <Label Text="{Binding PersistenceMessage}" FontSize="11" TextColor="#F2A5A5" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🏆 Logros" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="VER TODOS" FontSize="10" FontAttributes="Bold" TextColor="#C7A4FF" VerticalOptions="Center" />
                        </Grid>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <Border Padding="10" WidthRequest="142" Stroke="#315B48" StrokeShape="RoundRectangle 12" BackgroundColor="#202D2A">
                                    <HorizontalStackLayout Spacing="8"><Label Text="🟢" FontSize="22" VerticalOptions="Center" /><VerticalStackLayout Spacing="1"><Label Text="Primer paso" FontSize="12" FontAttributes="Bold" TextColor="#82E59B" /><Label Text="Primera entrada" FontSize="10" TextColor="#C3C0CC" /></VerticalStackLayout></HorizontalStackLayout>
                                </Border>
                                <Border Padding="10" WidthRequest="142" Stroke="#70502C" StrokeShape="RoundRectangle 12" BackgroundColor="#302720">
                                    <HorizontalStackLayout Spacing="8"><Label Text="🔥" FontSize="22" VerticalOptions="Center" /><VerticalStackLayout Spacing="1"><Label Text="Constante" FontSize="12" FontAttributes="Bold" TextColor="#FFC45D" /><Label Text="7 días seguidos" FontSize="10" TextColor="#C3C0CC" /></VerticalStackLayout></HorizontalStackLayout>
                                </Border>
                                <Border Padding="10" WidthRequest="142" Stroke="#365B82" StrokeShape="RoundRectangle 12" BackgroundColor="#202A38">
                                    <HorizontalStackLayout Spacing="8"><Label Text="🎯" FontSize="22" VerticalOptions="Center" /><VerticalStackLayout Spacing="1"><Label Text="Como va!" FontSize="12" FontAttributes="Bold" TextColor="#8CCBFF" /><Label Text="50% del objetivo" FontSize="10" TextColor="#C3C0CC" /></VerticalStackLayout></HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="DrawerScrim" Grid.ColumnSpan="3" IsVisible="False" BackgroundColor="#99070810" ZIndex="1">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="NavigationPanel" Grid.ColumnSpan="3" IsVisible="False" ZIndex="2" WidthRequest="280" HorizontalOptions="Start" Padding="16,18" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="#171723">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
                <VerticalStackLayout Spacing="4">
                    <Label Text="🎯 ObjectiveReacher" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                    <Label Text="Tu progreso, a tu ritmo" FontSize="12" TextColor="#AAA5BB" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Row="1" Spacing="7">
                    <Button Text="🎯   Objetivo actual" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="#302747" TextColor="#E6D9FF" CornerRadius="12" />
                    <Button Text="＋   Entradas" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button Text="▤   Historial" Clicked="OnHistoryClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button Text="▥   Estadísticas" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button Text="🏆   Logros" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                    <Button Text="⚙   Ajustes" Clicked="OnNavigationItemClicked" HeightRequest="48" HorizontalOptions="Fill" BackgroundColor="Transparent" TextColor="{StaticResource DashboardText}" />
                </VerticalStackLayout>
                <Border Grid.Row="2" Padding="12" Stroke="#343046" StrokeShape="RoundRectangle 14" BackgroundColor="#211F30">
                    <VerticalStackLayout Spacing="4"><Label Text="🔥 Racha actual" FontSize="13" FontAttributes="Bold" TextColor="#FFC45D" /><Label Text="7 días · ¡Sigue así!" FontSize="12" TextColor="#E4DFED" /></VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="HistoryPanel" Grid.ColumnSpan="3" IsVisible="False" ZIndex="2" WidthRequest="320" HorizontalOptions="End" Padding="16,18" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="#171723">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2"><Label Text="Registro de entradas" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" /><Label Text="{Binding HistoryBalanceText}" FontSize="12" TextColor="{StaticResource DashboardMutedText}" /></VerticalStackLayout>
                    <Button Grid.Column="1" Text="×" Clicked="OnClosePanelsClicked" WidthRequest="42" HeightRequest="42" Padding="0" FontSize="22" BackgroundColor="{StaticResource DashboardRaisedPanel}" TextColor="{StaticResource DashboardText}" CornerRadius="12" SemanticProperties.Description="Cerrar historial" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Text="Todas" Command="{Binding SetHistoryFilterCommand}" CommandParameter="all" HeightRequest="40" Padding="2" FontSize="11" BackgroundColor="{Binding AllFilterBackground}" TextColor="White" CornerRadius="10" />
                    <Button Grid.Column="1" Text="Sumas" Command="{Binding SetHistoryFilterCommand}" CommandParameter="add" HeightRequest="40" Padding="2" FontSize="11" BackgroundColor="{Binding AddFilterBackground}" TextColor="#C8C2D6" CornerRadius="10" />
                    <Button Grid.Column="2" Text="Restas" Command="{Binding SetHistoryFilterCommand}" CommandParameter="subtract" HeightRequest="40" Padding="2" FontSize="11" BackgroundColor="{Binding SubtractFilterBackground}" TextColor="#C8C2D6" CornerRadius="10" />
                </Grid>
                <CollectionView ItemsSource="{Binding HistoryEntries}" Grid.Row="2" SelectionMode="None">
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Stroke="#2E2C40" StrokeShape="RoundRectangle 12" BackgroundColor="#201F2E">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                    <Label Text="{Binding Symbol}" FontSize="17" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="{Binding Description}" FontSize="13" FontAttributes="Bold" TextColor="#F3F0FA" /><Label Text="{Binding TimeText}" FontSize="10" TextColor="#A8A3B8" /></VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding AmountText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>
    </Grid>
</ContentPage>