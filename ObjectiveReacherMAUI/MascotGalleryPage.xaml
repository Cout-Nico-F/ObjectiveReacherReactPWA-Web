<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ObjectiveReacherMAUI.Controls"
             x:Class="ObjectiveReacherMAUI.MascotGalleryPage"
             Title="Evolución de Mascotas"
             BackgroundColor="{StaticResource DashboardBackground}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="18" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                <Label Text="🐾 Códice de Mascotas (1–200)" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                <Label Text="Sube de nivel registrando entradas para revelar las siluetas misteriosas." FontSize="12" TextColor="{StaticResource DashboardMutedText}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Cerrar" Clicked="OnCloseClicked" BackgroundColor="#302747" TextColor="{StaticResource DashboardText}" CornerRadius="10" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Padding="14" Stroke="{StaticResource DashboardOutline}" StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource DashboardPanel}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                <controls:MascotAvatarView x:Name="PreviewMascotView" Level="1" WidthRequest="84" HeightRequest="84" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <Label x:Name="PreviewLevelLabel" Text="Nivel 1" FontSize="16" FontAttributes="Bold" TextColor="#D8C5FF" />
                    <Label x:Name="PreviewStageLabel" Text="Etapa 1 · Brote Esmeralda" FontSize="12" TextColor="{StaticResource DashboardMutedText}" />
                    <Label x:Name="PreviewHintLabel" Text="" FontSize="11" TextColor="#C7A4FF" />
                    <Slider x:Name="LevelSlider" Minimum="1" Maximum="200" Value="1" ValueChanged="OnSliderValueChanged" MinimumTrackColor="#B58BFF" MaximumTrackColor="#38324E" ThumbColor="#FFD54F" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="2" x:Name="MascotCollectionView" SelectionMode="None" ItemsLayout="VerticalGrid, 4" VerticalScrollBarVisibility="Always">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4">
                        <Border Padding="8" Stroke="{Binding BorderColor}" StrokeShape="RoundRectangle 14" BackgroundColor="{Binding CardBackground}">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <controls:MascotAvatarView Level="{Binding Level}" IsLocked="{Binding IsLocked}" WidthRequest="52" HeightRequest="52" HorizontalOptions="Center" />
                                <Label Text="{Binding Label}" FontSize="11" FontAttributes="Bold" TextColor="{Binding TitleColor}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Stage}" FontSize="9" TextColor="#A8A3B8" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
