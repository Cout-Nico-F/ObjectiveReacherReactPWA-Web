<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ObjectiveReacherMAUI.AchievementsPage"
             Title="Todos los logros"
             BackgroundColor="{StaticResource DashboardBackground}">
    <Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                <Label Text="🏆 Todos los logros" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource DashboardText}" />
                <Label Text="Toca una tarjeta para ver su pista o recompensa." FontSize="12" TextColor="{StaticResource DashboardMutedText}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Cerrar" Clicked="OnCloseClicked" BackgroundColor="#302747" TextColor="{StaticResource DashboardText}" CornerRadius="10" VerticalOptions="Center" />
        </Grid>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Achievements}" SelectionMode="None" ItemsLayout="VerticalGrid, 2" VerticalScrollBarVisibility="Always">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5" HeightRequest="120">
                        <Border Padding="10" Stroke="{Binding TitleColor}" StrokeShape="RoundRectangle 12" BackgroundColor="{Binding CardBackground}" InputTransparent="True">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="7">
                                    <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" />
                                    <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="{Binding TitleColor}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Description}" FontSize="10" TextColor="#C3C0CC" LineBreakMode="TailTruncation" MaxLines="2" />
                                <Label Text="{Binding StatusText}" FontSize="9" TextColor="#D8D1E5" />
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="" BackgroundColor="Transparent" Clicked="OnAchievementClicked" CommandParameter="{Binding .}" SemanticProperties.Description="{Binding AccessibilityText}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
