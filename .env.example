# ============================================================================
# OBJECTIVE REACHER — ARQUITECTURA DUAL DE PAGOS WEB & ANDROID
# ============================================================================
# Copia este archivo como `.env` en tu entorno local o configura estas
# variables en tu servidor de deploy (Cloud Run / Railway / Render / Vercel).
# Nunca subas tus claves reales al repositorio público.

# ----------------------------------------------------------------------------
# 1. SEGURIDAD Y FIRMA DE LICENCIAS / RECIBOS PRO (HMAC-SHA256)
# ----------------------------------------------------------------------------
# Cambia esta frase secreta por cualquier cadena larga y aleatoria tuya.
# Con esta clave el servidor firma códigos de recuperación (OR-PRO-...)
# que no pueden ser falsificados y permiten restaurar compras sin base de datos.
PAYMENT_LICENSE_SECRET=PLACEHOLDER_CAMBIAR_POR_TU_SECRETO_HMAC_PRIVADO_2026

# URL pública de tu aplicación web (para retornos de pasarela y webhooks)
PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 2. PASARELA LATAM / ARGENTINA: MERCADO PAGO (Checkout Pro + Webhooks)
# ----------------------------------------------------------------------------
# Obtén tus credenciales en: https://www.mercadopago.com.ar/developers/panel/app
VITE_MP_PUBLIC_KEY=APP_USR-PLACEHOLDER-TU-PUBLIC-KEY-DE-MERCADOPAGO
MP_ACCESS_TOKEN=APP_USR-PLACEHOLDER-TU-ACCESS-TOKEN-PRIVADO-DE-MERCADOPAGO
MP_WEBHOOK_SECRET=PLACEHOLDER_TU_CLAVE_SECRETA_WEBHOOK_MP

# Tipo de cambio de referencia USD -> ARS para convertir packs y propinas en MP
MP_USD_TO_ARS_RATE=1250

# Links directos opcionales de pago rápido (si prefieres links estáticos mientras configuras API):
VITE_MP_LINK_COFFEE=
VITE_MP_LINK_FOUNDER=
VITE_MP_LINK_GEM_CHEST=
VITE_MP_LINK_CUSTOM_TIP=

# ----------------------------------------------------------------------------
# 3. PASARELA GLOBAL: PAYPAL + GOOGLE PAY + TARJETAS INTERNACIONALES
# ----------------------------------------------------------------------------
# Opción A: PayPal REST API Oficial (PayPal + PayPal Google Pay / Tarjetas)
# Obtén tus credenciales en: https://developer.paypal.com/dashboard/applications
VITE_PAYPAL_CLIENT_ID=PLACEHOLDER_TU_PAYPAL_CLIENT_ID_GLOBAL
PAYPAL_CLIENT_SECRET=PLACEHOLDER_TU_PAYPAL_CLIENT_SECRET_PRIVADO
# Usa 'sandbox' para pruebas o 'live' para producción real
PAYPAL_ENV=sandbox

# Opción B: Merchant of Record Global (Lemon Squeezy / Paddle — incluye Google Pay, Apple Pay y PayPal)
# Si decides usar Lemon Squeezy a mediano/largo plazo para automatizar impuestos globales:
VITE_GLOBAL_CHECKOUT_COFFEE_URL=
VITE_GLOBAL_CHECKOUT_FOUNDER_URL=
VITE_GLOBAL_CHECKOUT_GEM_CHEST_URL=
VITE_GLOBAL_CHECKOUT_CUSTOM_TIP_URL=
GLOBAL_WEBHOOK_SECRET=PLACEHOLDER_TU_WEBHOOK_SECRET_GLOBAL
